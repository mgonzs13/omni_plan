<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omni_plan_mrta</name>
  <version>1.0.0</version>
  <description>Multi-Robot Task Allocation (MRTA) planner for omni_plan: pluggable task allocation algorithms and plan merging without LLM dependency</description>
  <maintainer email="mgons@unileon.es">Miguel Ángel González Santamarta</maintainer>
  <license>GPL-3.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <depend>omni_plan</depend>
  <depend>yasmin_ros</depend>
  <depend>poirot</depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
